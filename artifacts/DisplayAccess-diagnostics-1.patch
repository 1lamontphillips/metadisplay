+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.clip
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.text.font.FontFamily
+import androidx.compose.ui.unit.dp
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.meta.wearable.dat.externalsampleapps.displayaccess.SessionDiagnostics
+
+@Composable
+fun ConnectionDiagnosticsCard() {
+  val events by SessionDiagnostics.events.collectAsStateWithLifecycle()
+  val context = LocalContext.current
+  Column(
+      modifier = Modifier.fillMaxWidth().clip(RoundedCornerShape(26.dp))
+          .background(Color.White).padding(20.dp),
+      verticalArrangement = Arrangement.spacedBy(10.dp),
+  ) {
+    Text("Connection details", style = MaterialTheme.typography.titleLarge, color = Color.Black)
+    Text(
+        "Diagnostic update 1. Try the sample once, return here, then copy the details to share for troubleshooting.",
+        style = MaterialTheme.typography.bodyMedium,
+        color = Color.DarkGray,
+    )
+    SelectionContainer {
+      Text(
+          text = events.takeLast(30).joinToString("\n").ifEmpty { "Waiting for connection events…" },
+          modifier = Modifier.fillMaxWidth().heightIn(max = 240.dp)
+              .verticalScroll(rememberScrollState()),
+          style = MaterialTheme.typography.bodySmall,
+          fontFamily = FontFamily.Monospace,
+          color = Color.Black,
+      )
+    }
+    Button(
+        onClick = {
+          val clipboard = context.getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager
+          clipboard.setPrimaryClip(ClipData.newPlainText("Display Access connection details", SessionDiagnostics.report()))
+          Toast.makeText(context, "Connection details copied", Toast.LENGTH_SHORT).show()
+        },
+        modifier = Modifier.fillMaxWidth(),
+    ) { Text("Copy connection details") }
+    TextButton(onClick = { SessionDiagnostics.clear() }) { Text("Clear details") }
+    Text(
+        "Stored only while the app is running. No automatic upload; device names and identifiers are excluded.",
+        style = MaterialTheme.typography.bodySmall,
+        color = Color.DarkGray,
+    )
+  }
+}
