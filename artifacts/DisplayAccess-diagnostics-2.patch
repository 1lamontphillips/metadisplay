+package com.meta.wearable.dat.externalsampleapps.displayaccess
+
+import android.os.SystemClock
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/** A bounded, in-memory trace shared only when the user copies it. */
+object SessionDiagnostics {
+  private const val LIMIT = 100
+  private val lock = Any()
+  private val startedAt = SystemClock.elapsedRealtime()
+  private val _events = MutableStateFlow<List<String>>(emptyList())
+  val events: StateFlow<List<String>> = _events.asStateFlow()
+
+  fun record(event: String) {
+    synchronized(lock) {
+      val elapsed = SystemClock.elapsedRealtime() - startedAt
+      _events.value = (_events.value + "+${elapsed}ms $event").takeLast(LIMIT)
+    }
+  }
+
+  fun report(): String =
+      "Display Access diagnostic update 2\nSDK 1.0.1; Android API ${android.os.Build.VERSION.SDK_INT}\n" +
+          "Detail images enabled=${DiagnosticOptions.includeDetailImages.value}\n" +
+          "App developer configuration is not a check of companion Developer Mode.\n\n" +
+          _events.value.joinToString("\n")
+
+  fun clear() {
+    synchronized(lock) { _events.value = emptyList() }
+    record("Previous events cleared")
+  }
+}
